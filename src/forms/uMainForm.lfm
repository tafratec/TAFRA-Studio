object MainForm: TMainForm
  Left = 300
  Height = 700
  Top = 180
  Width = 1050
  Caption = 'TAFRA Studio'
  ClientHeight = 700
  ClientWidth = 1050
  Menu = MainMenu
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Position = poScreenCenter
  LCLVersion = '4.8'
  object ToolBar: TToolBar
    Left = 0
    Height = 30
    Top = 0
    Width = 1050
    Align = alTop
    Caption = 'ToolBar'
    EdgeBorders = [ebTop, ebBottom]
    ShowCaptions = True
    TabOrder = 0
  end
  object StatusBar: TStatusBar
    Left = 0
    Height = 23
    Top = 677
    Width = 1050
    Align = alBottom
    Panels = <>
    SimplePanel = True
  end
  object ContentPanel: TPanel
    Left = 0
    Height = 647
    Top = 30
    Width = 1050
    Align = alClient
    BevelOuter = bvNone
    Caption = ''
    TabOrder = 1
    object OutputPanel: TPanel
      Left = 0
      Height = 150
      Top = 497
      Width = 1050
      Align = alBottom
      Caption = 'Output / Log'
      TabOrder = 0
      object OutputMemo: TMemo
        Left = 1
        Height = 130
        Top = 19
        Width = 1048
        Align = alClient
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
        WordWrap = False
      end
    end
    object OutputSplitter: TSplitter
      Left = 0
      Height = 5
      Top = 492
      Width = 1050
      Align = alBottom
      ResizeAnchor = akBottom
    end
    object ProjectExplorerPanel: TPanel
      Left = 0
      Height = 492
      Top = 0
      Width = 250
      Align = alLeft
      Caption = 'Project Explorer'
      TabOrder = 1
      object ProjectExplorerActionsPanel: TPanel
        Left = 1
        Height = 30
        Top = 19
        Width = 248
        Align = alTop
        BevelOuter = bvNone
        Caption = ''
        TabOrder = 0
        object ExpandAllProjectButton: TButton
          Left = 4
          Height = 24
          Top = 3
          Width = 86
          Caption = 'Expand All'
          OnClick = ExpandAllProjectButtonClick
          TabOrder = 0
        end
        object CollapseAllProjectButton: TButton
          Left = 94
          Height = 24
          Top = 3
          Width = 88
          Caption = 'Collapse All'
          OnClick = CollapseAllProjectButtonClick
          TabOrder = 1
        end
      end
      object ProjectTreeView: TTreeView
        Left = 1
        Height = 442
        Top = 49
        Width = 248
        Align = alClient
        HideSelection = False
        OnChange = ProjectTreeViewChange
        OnCustomDraw = ProjectTreeViewCustomDraw
        OnCustomDrawItem = ProjectTreeViewCustomDrawItem
        OnMouseDown = ProjectTreeViewMouseDown
        TabOrder = 1
      end
    end
    object ExplorerSplitter: TSplitter
      Left = 250
      Height = 492
      Top = 0
      Width = 5
      ResizeAnchor = akLeft
    end
    object WorkspacePanel: TPanel
      Left = 255
      Height = 492
      Top = 0
      Width = 795
      Align = alClient
      Caption = 'Workspace'
      TabOrder = 2
    end
  end
  object MainMenu: TMainMenu
    left = 24
    top = 48
    object FileMenuItem: TMenuItem
      Caption = '&File'
      object OpenProjectMenuItem: TMenuItem
        Caption = '&Open Project...'
        OnClick = OpenProjectMenuItemClick
      end
      object CloseProjectMenuItem: TMenuItem
        Caption = '&Close Project'
        OnClick = CloseProjectMenuItemClick
      end
      object RecentProjectsMenuItem: TMenuItem
        Caption = '&Recent Projects'
        Enabled = False
      end
      object SeparatorMenuItem: TMenuItem
        Caption = '-'
      end
      object ExitMenuItem: TMenuItem
        Caption = 'E&xit'
        OnClick = ExitMenuItemClick
      end
    end
    object ViewMenuItem: TMenuItem
      Caption = '&View'
      object ProjectExplorerMenuItem: TMenuItem
        AutoCheck = True
        Caption = '&Project Explorer'
        Checked = True
        OnClick = ProjectExplorerMenuItemClick
      end
      object OutputMenuItem: TMenuItem
        AutoCheck = True
        Caption = '&Output'
        Checked = True
        OnClick = OutputMenuItemClick
      end
    end
    object ProjectMenuItem: TMenuItem
      Caption = '&Project'
      Enabled = False
    end
    object ToolsMenuItem: TMenuItem
      Caption = '&Tools'
      object PasswordGeneratorMenuItem: TMenuItem
        Caption = '&Password Generator...'
        OnClick = PasswordGeneratorMenuItemClick
      end
    end
    object SettingsMenuItem: TMenuItem
      Caption = '&Settings'
      object ApplicationSettingsMenuItem: TMenuItem
        Caption = '&Application Settings...'
        OnClick = ApplicationSettingsMenuItemClick
      end
    end
    object HelpMenuItem: TMenuItem
      Caption = '&Help'
      object AboutMenuItem: TMenuItem
        Caption = '&About'
        OnClick = AboutMenuItemClick
      end
    end
  end
  object SelectDirectoryDialog: TSelectDirectoryDialog
    Title = 'Select TAFRA Project Directory'
    left = 120
    top = 48
  end
