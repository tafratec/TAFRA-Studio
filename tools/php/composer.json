{
  "name": "tafra/studio-php-tools",
  "description": "Private Composer dependencies used by TAFRA Studio PHP tooling.",
  "type": "project",
  "require": {
    "phpstan/phpstan": "^2.3.1",
    "squizlabs/php_codesniffer": "^3.13",
    "friendsofphp/php-cs-fixer": "^3.95.27"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
